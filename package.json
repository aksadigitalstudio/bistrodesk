{
  "name": "bistrodesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --port 4190 --configLoader native",
    "test:ui": "node tests/ui.mjs",
    "test:database": "node tests/database.mjs",
    "format": "prettier --write src tests vite.config.ts",
    "test:cloud": "node tests/cloud-contract.mjs",
    "start": "npm run build && npm run preview",
    "test:regression": "node tests/regression.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
